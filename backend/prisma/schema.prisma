generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  MANAGER
  CASHIER
  USER
}

enum ContactType {
  CUSTOMER
  SUPPLIER
  BOTH
}

enum ProductType {
  RETAIL
  SERVICE
  BUNDLE
}

enum StockMovementType {
  IN
  OUT
  TRANSFER
  ADJUSTMENT
  RETURN
}

enum CashMovementType {
  IN
  OUT
}

enum SaleChannel {
  RETAIL
}

enum SaleStatus {
  DRAFT
  SUSPENDED
  FINAL
  CANCELLED
  PARTIALLY_RETURNED
  RETURNED
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  CHEQUE
  CREDIT
  MIXED
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
  REFUNDED
}

enum PurchaseStatus {
  PENDING
  PARTIALLY_RECEIVED
  RECEIVED
  RETURNED
}

model Company {
  id                Int      @id @default(autoincrement())
  accountId         String?  @unique
  name              String
  legalName         String?
  email             String?
  phone             String?
  address           String?
  city              String?
  logoUrl           String?
  ice               String?
  ifNumber          String?
  rc                String?
  patente           String?
  cnss              String?
  defaultCurrency   String   @default("MAD")
  defaultTvaRate    Decimal  @default(20) @db.Decimal(5, 2)
  receiptFooter     String?
  posEnabled        Boolean  @default(true)
  invoiceEnabled    Boolean  @default(false)
  opticEnabled      Boolean  @default(false)
  multiWarehouse    Boolean  @default(false)
  settings          Json     @default("{}")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  users            User[]
  locations        Location[]
  contacts         Contact[]
  categories       Category[]
  brands           Brand[]
  units            Unit[]
  products         Product[]
  warehouses       Warehouse[]
  sales            Sale[]
  purchases        Purchase[]
  cashSessions     CashRegisterSession[]
  expenses         Expense[]
  cashMovements    CashMovement[]
  invoices         Invoice[]
  taxRates         TaxRate[]
  customerGroups   CustomerGroup[]
  priceGroups      SellingPriceGroup[]
  accountTypes     AccountType[]
  accounts         Account[]
  commissionAgents SalesCommissionAgent[]
  notificationTemplates NotificationTemplate[]
  documentsAndNotes     DocumentAndNote[]
  dashboardConfigurations DashboardConfiguration[]
  devices               Device[]
  currencies            Currency[]
  warranties            Warranty[]
  variationTemplates    VariationTemplate[]
  discounts             Discount[]
  consolidatedInvoices  ConsolidatedInvoice[]
}

model User {
  id           Int      @id @default(autoincrement())
  companyId    Int
  username     String
  email        String?
  passwordHash String
  fullName     String
  role         UserRole @default(CASHIER)
  isActive     Boolean  @default(true)
  pinHash      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company        Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sales          Sale[]                   @relation("SaleCashier")
  cashSessions   CashRegisterSession[]
  attendances    Attendance[]
  dashboardConfigurations DashboardConfiguration[]
  permissions    UserPermission[]

  @@unique([companyId, username])
  @@unique([companyId, email])
}

// Track E (2026-08-13): per-user permission overrides on top of the existing
// UserRole presets, not a replacement for them. Empty by default - a user
// with zero rows here gets exactly today's requireRole() behavior. An ADMIN
// can grant or revoke one specific action for one specific user without
// touching the role system at all. Deliberately NOT a full per-action matrix
// (see TRACE.md for the reasoning) - this is the smallest thing that lets a
// real store say "this cashier can also do X" without rebuilding auth.
model UserPermission {
  id        Int      @id @default(autoincrement())
  userId    Int
  action    String
  granted   Boolean
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, action])
}

model Location {
  id        Int      @id @default(autoincrement())
  companyId Int
  name      String
  address   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company       Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  warehouses    Warehouse[]
  sales         Sale[]
  cashSessions  CashRegisterSession[]
  expenses      Expense[]
  cashMovements CashMovement[]
  // Track D auto-posting (2026-08-12): per-location cash account, lazily
  // get-or-created the same way "Magasin principal" warehouses are.
  accounts      Account[]
  devices       Device[]
  discounts     Discount[]
  consolidatedInvoices ConsolidatedInvoice[]

  @@unique([companyId, name])
}

model Contact {
  id              Int         @id @default(autoincrement())
  companyId       Int
  type            ContactType @default(CUSTOMER)
  fullName        String
  phone           String?
  email           String?
  address         String?
  ice             String?
  ifNumber        String?
  creditLimit     Decimal?    @db.Decimal(12, 2)
  balance         Decimal     @default(0) @db.Decimal(12, 2)
  isActive        Boolean     @default(true)
  customerGroupId Int?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customerGroup CustomerGroup? @relation(fields: [customerGroupId], references: [id])
  sales         Sale[]
  purchases     Purchase[]
  invoices      Invoice[]
  consolidatedInvoices ConsolidatedInvoice[]

  @@index([companyId, type])
}

// Track C (catalog/pricing depth): a customer group carries an optional selling
// price group, which carries per-product price overrides. Schema + list/create
// CRUD only in this pass - resolving group pricing into the POS cart is
// register-adjacent (TRACE.md: register logic is critical/easy to regress) and
// deferred to a session with browser access, same as the return/credit-note flow.
model CustomerGroup {
  id           Int      @id @default(autoincrement())
  companyId    Int
  name         String
  priceGroupId Int?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  company    Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  priceGroup SellingPriceGroup? @relation(fields: [priceGroupId], references: [id])
  contacts   Contact[]

  @@unique([companyId, name])
}

model SellingPriceGroup {
  id        Int      @id @default(autoincrement())
  companyId Int
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  company        Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customerGroups CustomerGroup[]
  productPrices  ProductGroupPrice[]

  @@unique([companyId, name])
}

model ProductGroupPrice {
  id           Int     @id @default(autoincrement())
  productId    Int
  priceGroupId Int
  price        Decimal @db.Decimal(12, 2)

  product    Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  priceGroup SellingPriceGroup @relation(fields: [priceGroupId], references: [id], onDelete: Cascade)

  @@unique([productId, priceGroupId])
}

model Category {
  id        Int     @id @default(autoincrement())
  companyId Int
  name      String
  color     String?
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  products  Product[]
  discounts Discount[]

  @@unique([companyId, name])
}

model Brand {
  id        Int    @id @default(autoincrement())
  companyId Int
  name      String

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  products  Product[]
  discounts Discount[]

  @@unique([companyId, name])
}

model Unit {
  id           Int     @id @default(autoincrement())
  companyId    Int
  name         String
  shortName    String
  allowDecimal Boolean @default(false)

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([companyId, shortName])
}

// Named/group tax rates (Track: Financial/Accounting groundwork). Additive only -
// Product/SaleItem/InvoiceLine keep their existing snapshotted `tvaRate` Decimal;
// `taxRateId` lets new writes resolve a rate from here while still snapshotting the
// resulting number, so historical fiscal data on completed sales/invoices never changes
// retroactively (see TRACE.md Phase 2 entry, 2026-08-12).
model TaxRate {
  id         Int     @id @default(autoincrement())
  companyId  Int
  name       String
  rate       Decimal @db.Decimal(5, 2)
  isGroup    Boolean @default(false)
  parentId   Int?
  isActive   Boolean @default(true)

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parent       TaxRate?      @relation("TaxRateGroup", fields: [parentId], references: [id])
  children     TaxRate[]     @relation("TaxRateGroup")
  products     Product[]
  saleItems    SaleItem[]
  invoiceLines InvoiceLine[]

  @@unique([companyId, name])
}

model Product {
  id            Int                @id @default(autoincrement())
  companyId     Int
  categoryId    Int?
  brandId       Int?
  unitId        Int?
  taxRateId     Int?
  warrantyId    Int?
  sku           String
  barcode       String?
  name          String
  description   String?
  type          ProductType        @default(RETAIL)
  imageUrl      String?
  purchasePrice Decimal            @default(0) @db.Decimal(12, 2)
  salePrice     Decimal            @db.Decimal(12, 2)
  tvaRate       Decimal            @default(20) @db.Decimal(5, 2)
  trackStock    Boolean            @default(true)
  lowStockAlert Decimal            @default(0) @db.Decimal(12, 3)
  isActive      Boolean            @default(true)
  isSellable    Boolean            @default(true)
  isVariable    Boolean            @default(false)
  variationOptions Json?
  variations    ProductVariation[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category        Category?        @relation(fields: [categoryId], references: [id])
  brand           Brand?           @relation(fields: [brandId], references: [id])
  unit            Unit?            @relation(fields: [unitId], references: [id])
  taxRate         TaxRate?         @relation(fields: [taxRateId], references: [id])
  warranty        Warranty?        @relation(fields: [warrantyId], references: [id])
  stocks          ProductStock[]
  stockMovements  StockMovement[]
  saleItems       SaleItem[]
  purchaseItems   PurchaseItem[]
  invoiceLines    InvoiceLine[]
  groupPrices     ProductGroupPrice[]

  @@unique([companyId, sku])
  @@unique([companyId, barcode])
  @@index([companyId, type])
}

model Warehouse {
  id         Int     @id @default(autoincrement())
  companyId  Int
  locationId Int?
  name       String
  isMain     Boolean @default(false)
  isActive   Boolean @default(true)

  company   Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  location  Location?       @relation(fields: [locationId], references: [id])
  stocks    ProductStock[]
  movements StockMovement[]

  @@unique([companyId, name])
}

model ProductStock {
  id          Int               @id @default(autoincrement())
  productId   Int
  warehouseId Int
  variationId Int?
  variation   ProductVariation? @relation(fields: [variationId], references: [id])
  quantity    Decimal           @default(0) @db.Decimal(12, 3)
  updatedAt   DateTime          @updatedAt

  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([productId, warehouseId, variationId])
}

model StockMovement {
  id          Int               @id @default(autoincrement())
  productId   Int
  warehouseId Int
  type        StockMovementType
  quantity    Decimal           @db.Decimal(12, 3)
  reference   String?
  notes       String?
  createdAt   DateTime          @default(now())

  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
}

model Sale {
  id            Int           @id @default(autoincrement())
  companyId     Int
  locationId    Int?
  customerId    Int?
  cashierId     Int?
  channel       SaleChannel   @default(RETAIL)
  status        SaleStatus    @default(DRAFT)
  paymentStatus PaymentStatus @default(UNPAID)
  invoiceNumber String?
  ticketNumber  String?
  note          String?
  subtotal      Decimal       @default(0) @db.Decimal(12, 2)
  discountTotal Decimal       @default(0) @db.Decimal(12, 2)
  taxTotal      Decimal       @default(0) @db.Decimal(12, 2)
  total         Decimal       @default(0) @db.Decimal(12, 2)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  finalizedAt   DateTime?
  invoiceId     Int?
  invoice       Invoice?      @relation(fields: [invoiceId], references: [id])
  consolidatedInvoiceId Int?
  consolidatedInvoice   ConsolidatedInvoice? @relation("ConsolidatedInvoiceSales", fields: [consolidatedInvoiceId], references: [id])
  originalSaleId Int?
  commissionAgentId Int?
  externalId    String?       @unique
  currencyId    Int?
  exchangeRate  Decimal?      @db.Decimal(12, 6)
  foreignTotal  Decimal?      @db.Decimal(12, 2)

  company         Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  location        Location?             @relation(fields: [locationId], references: [id])
  customer        Contact?              @relation(fields: [customerId], references: [id])
  cashier         User?                 @relation("SaleCashier", fields: [cashierId], references: [id])
  items           SaleItem[]
  payments        Payment[]
  originalSale    Sale?                 @relation("SaleReturns", fields: [originalSaleId], references: [id])
  returns         Sale[]                @relation("SaleReturns")
  commissionAgent SalesCommissionAgent? @relation(fields: [commissionAgentId], references: [id])
  currency        Currency?             @relation(fields: [currencyId], references: [id])

  @@index([companyId, channel, status])
}

model SaleItem {
  id            Int                    @id @default(autoincrement())
  saleId        Int
  productId     Int
  variationId   Int?
  variation     ProductVariation?      @relation(fields: [variationId], references: [id])
  taxRateId     Int?
  resolvedTaxRate TaxRate?             @relation(fields: [taxRateId], references: [id])
  quantity      Decimal                @db.Decimal(12, 3)
  unitPrice     Decimal                @db.Decimal(12, 2)
  discount      Decimal                @default(0) @db.Decimal(12, 2)
  tvaRate       Decimal                @default(20) @db.Decimal(5, 2)
  returnedQty   Decimal?               @db.Decimal(12, 3)
  lineTotal     Decimal                @db.Decimal(12, 2)
  notes         String?

  sale      Sale               @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product   Product            @relation(fields: [productId], references: [id])
}

model Payment {
  id        Int           @id @default(autoincrement())
  saleId    Int
  method    PaymentMethod
  amount    Decimal       @db.Decimal(12, 2)
  reference String?
  paidAt    DateTime      @default(now())

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)
}

model Purchase {
  id         Int      @id @default(autoincrement())
  companyId  Int
  supplierId Int?
  reference  String?
  subtotal   Decimal  @default(0) @db.Decimal(12, 2)
  taxTotal   Decimal  @default(0) @db.Decimal(12, 2)
  total      Decimal  @default(0) @db.Decimal(12, 2)
  status     PurchaseStatus @default(RECEIVED)
  createdAt  DateTime @default(now())
  // Track H (multi-currency): same treatment as Sale above - total stays in
  // MAD (supplier-balance increments and everything downstream keep reading
  // it unchanged), these three are the recorded foreign-currency equivalent
  // when a supplier invoice arrived priced in EUR/USD/etc.
  currencyId   Int?
  exchangeRate Decimal? @db.Decimal(12, 6)
  foreignTotal Decimal? @db.Decimal(12, 2)

  company  Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplier Contact?       @relation(fields: [supplierId], references: [id])
  currency Currency?      @relation(fields: [currencyId], references: [id])
  items    PurchaseItem[]
}

model PurchaseItem {
  id         Int     @id @default(autoincrement())
  purchaseId Int
  productId  Int
  quantity    Decimal @db.Decimal(12, 3)
  unitCost    Decimal @db.Decimal(12, 2)
  lineTotal   Decimal @db.Decimal(12, 2)
  receivedQty Decimal @default(0) @db.Decimal(12, 3)
  returnedQty Decimal @default(0) @db.Decimal(12, 3)

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id])
}

model CashRegisterSession {
  id           Int       @id @default(autoincrement())
  companyId    Int
  locationId   Int?
  userId       Int
  openedAt     DateTime  @default(now())
  closedAt     DateTime?
  openingCash  Decimal   @default(0) @db.Decimal(12, 2)
  expectedCash Decimal   @default(0) @db.Decimal(12, 2)
  countedCash  Decimal?  @db.Decimal(12, 2)
  difference   Decimal?  @db.Decimal(12, 2)
  notes        String?

  company   Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  location  Location?      @relation(fields: [locationId], references: [id])
  user      User           @relation(fields: [userId], references: [id])
  movements CashMovement[]
}

model Expense {
  id            Int      @id @default(autoincrement())
  companyId     Int
  locationId    Int?
  reference     String?
  category      String
  amount        Decimal  @db.Decimal(12, 2)
  date          DateTime
  note          String?
  paymentMethod String   @default("CASH")
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  location Location? @relation(fields: [locationId], references: [id])
}

model CashMovement {
  id         Int              @id @default(autoincrement())
  companyId  Int
  locationId Int?
  sessionId  Int?
  type       CashMovementType
  amount     Decimal          @db.Decimal(12, 2)
  note       String?
  createdAt  DateTime         @default(now())

  company  Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  location Location?            @relation(fields: [locationId], references: [id])
  session  CashRegisterSession? @relation(fields: [sessionId], references: [id])
}

model Invoice {
  id         Int           @id @default(autoincrement())
  companyId  Int
  number     String        @unique
  customerId Int?
  subtotal   Decimal       @default(0) @db.Decimal(12, 2)
  taxTotal   Decimal       @default(0) @db.Decimal(12, 2)
  total      Decimal       @default(0) @db.Decimal(12, 2)
  status     InvoiceStatus @default(DRAFT)
  issueDate  DateTime      @default(now())
  dueDate    DateTime?
  notes      String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  company  Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer Contact?      @relation(fields: [customerId], references: [id])
  sales    Sale[]
  lines    InvoiceLine[]
}

model InvoiceLine {
  id          Int      @id @default(autoincrement())
  invoiceId   Int
  productId   Int?
  taxRateId   Int?
  description String
  quantity    Decimal  @db.Decimal(12, 3)
  unitPrice   Decimal  @db.Decimal(12, 2)
  tvaRate     Decimal  @default(20) @db.Decimal(5, 2)
  lineTotal   Decimal  @db.Decimal(12, 2)
  sortOrder   Int      @default(0)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  invoice  Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product  Product? @relation(fields: [productId], references: [id])
  taxRate  TaxRate? @relation(fields: [taxRateId], references: [id])

  @@index([invoiceId, sortOrder])
  @@index([productId])
}

model ProductVariation {
  id            Int      @id @default(autoincrement())
  productId     Int
  name          String
  attributes    Json?
  sku           String?
  barcode       String?
  purchasePrice Decimal? @db.Decimal(12, 2)
  salePrice     Decimal? @db.Decimal(12, 2)
  isActive      Boolean  @default(true)

  product   Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  stocks    ProductStock[]
  saleItems SaleItem[]
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  PARTIAL
  CANCELLED
}

model Attendance {
  id        Int       @id @default(autoincrement())
  companyId Int
  userId    Int
  user      User      @relation(fields: [userId], references: [id])
  clockIn   DateTime  @default(now())
  clockOut  DateTime?
  duration  Float?
}

// --- Track D: Financial/Accounting (schema + manual ledger CRUD only) ---
// Auto-posting from Sale/Purchase/Payment/Expense/CashMovement would require
// editing those routes' existing money-moving logic with no database to verify
// against - deferred to a DB-enabled session, same reasoning as the Sale
// return/credit-note flow. This pass adds the ledger itself plus a route to
// post entries manually/programmatically later.
enum AccountTransactionType {
  DEBIT
  CREDIT
}

model AccountType {
  id        Int      @id @default(autoincrement())
  companyId Int
  name      String
  createdAt DateTime @default(now())

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  accounts Account[]

  @@unique([companyId, name])
}

model Account {
  id             Int      @id @default(autoincrement())
  companyId      Int
  accountTypeId  Int?
  // Track D auto-posting (2026-08-12): null means a company-wide account (used
  // as the fallback target when a money-moving event has no locationId, e.g.
  // an expense recorded without a location). Non-null links this account to a
  // specific Location's cash drawer. Resolution always uses findFirst-then-
  // create (see backend/src/utils/accounting.ts), not a DB unique constraint -
  // Postgres treats multiple NULLs as distinct, so a unique index on a
  // nullable column can't be relied on the same way ProductStock's compound
  // key already taught this project not to (see TRACE.md 2026-08-12).
  locationId     Int?
  name           String
  accountNumber  String?
  openingBalance Decimal  @default(0) @db.Decimal(12, 2)
  currentBalance Decimal  @default(0) @db.Decimal(12, 2)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  company      Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  accountType  AccountType?         @relation(fields: [accountTypeId], references: [id])
  location     Location?            @relation(fields: [locationId], references: [id])
  transactions AccountTransaction[]

  @@unique([companyId, name])
}

model AccountTransaction {
  id        Int                    @id @default(autoincrement())
  accountId Int
  type      AccountTransactionType
  amount    Decimal                @db.Decimal(12, 2)
  reference String?
  note      String?
  createdAt DateTime               @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

// --- Track E: Sales commission agents (schema + CRUD only) ---
// Commission calculation at checkout is register-adjacent (same deferral as
// the POS cart itself) - this pass adds the agent model and lets a sale be
// tagged with one, without computing/posting any commission amount yet.
model SalesCommissionAgent {
  id             Int      @id @default(autoincrement())
  companyId      Int
  name           String
  commissionRate Decimal  @default(0) @db.Decimal(5, 2)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sales   Sale[]

  @@unique([companyId, name])
}

// --- Track F: Communications (schema + CRUD only, no trigger wiring) ---
// Wiring templates to actual events (low stock, payment received, ...) touches
// many existing action points across other routes - deferred. This pass adds
// the templates and a free-form note/attachment log that other entities can
// already reference by (entityType, entityId) without a schema change per type.
model NotificationTemplate {
  id        Int      @id @default(autoincrement())
  companyId Int
  event     String
  channel   String   @default("EMAIL")
  subject   String?
  body      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, event, channel])
}

model DocumentAndNote {
  id         Int      @id @default(autoincrement())
  companyId  Int
  entityType String
  entityId   Int
  note       String?
  fileUrl    String?
  createdAt  DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, entityType, entityId])
}

// --- Track I: Dashboard configurator (schema + save/load CRUD only) ---
model DashboardConfiguration {
  id        Int      @id @default(autoincrement())
  companyId Int
  userId    Int
  widgets   Json     @default("[]")
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([companyId, userId])
}

// Track G (2026-08-13): external device auth for the Hanout Express Android
// app. A separate auth path from User/oauth.routes.ts - Hanout authenticates
// as a *device* bound to one Location, not a logged-in user. An admin
// generates an activationCode from Settings (device row created with
// deviceId/deviceToken null); the device redeems it once via
// POST /device/activate, which fills in the device identity fields and
// issues a token pair. refreshTokenHash is a bcrypt hash, never the raw
// token - same reasoning as User.passwordHash.
model Device {
  id               Int       @id @default(autoincrement())
  companyId        Int
  locationId       Int
  activationCode   String    @unique
  phone            String?
  deviceId         String?   @unique
  deviceModel      String?
  appVersion       String?
  // SHA-256 digest of the refresh token, not bcrypt: the token itself is a
  // random 256-bit value, not a low-entropy secret like a password, so a
  // deterministic hash gives an indexed O(1) lookup on /device/refresh
  // (the client sends only the token, no device_id) with no meaningful
  // security loss versus bcrypt's slow, non-lookupable salted hash.
  refreshTokenHash String?   @unique
  activatedAt      DateTime?
  lastSeenAt       DateTime?
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

// Track H (2026-08-13): multi-currency, scoped to Sale + Purchase recording
// a foreign-currency equivalent alongside the company-currency (MAD) amount
// that stays authoritative everywhere else in the system. `rate` is the
// "current" manually-maintained exchange rate (units of company currency per
// 1 unit of this currency, e.g. rate=10.85 for EUR); each Sale/Purchase
// resolves and snapshots it at write time into its own exchangeRate field,
// same pattern as TaxRate -> Sale/PurchaseItem.tvaRate, so a later rate
// update never rewrites a historical document. No live FX API integration -
// deliberately manual, matching how tvaRate is manually configured too.
model Currency {
  id        Int      @id @default(autoincrement())
  companyId Int
  code      String   // ISO 4217, e.g. "EUR", "USD"
  name      String
  symbol    String?
  rate      Decimal  @db.Decimal(12, 6)
  isActive  Boolean  @default(true)
  updatedAt DateTime @updatedAt

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sales     Sale[]
  purchases Purchase[]

  @@unique([companyId, code])
}

model Warranty {
  id          Int      @id @default(autoincrement())
  companyId   Int
  name        String
  description String?
  duration    Int
  durationType String   @default("MONTHS")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([companyId, name])
}

model VariationTemplate {
  id        Int      @id @default(autoincrement())
  companyId Int
  name      String
  values    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, name])
}

model Discount {
  id           Int      @id @default(autoincrement())
  companyId    Int
  name         String
  discountType String   @default("PERCENTAGE")
  amount       Decimal  @db.Decimal(12, 2)
  startDate    DateTime?
  endDate      DateTime?
  appliesTo    String   @default("ALL")
  brandId      Int?
  categoryId   Int?
  productIds   Json?
  locationId   Int?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  brand    Brand?    @relation(fields: [brandId], references: [id])
  category Category? @relation(fields: [categoryId], references: [id])
  location Location? @relation(fields: [locationId], references: [id])

  @@index([companyId])
}

model ConsolidatedInvoice {
  id           Int      @id @default(autoincrement())
  companyId    Int
  locationId   Int?
  customerId   Int
  reference    String
  periodStart  DateTime
  periodEnd    DateTime
  total        Decimal  @db.Decimal(12, 2)
  taxTotal     Decimal  @db.Decimal(12, 2)
  status       String   @default("ISSUED")
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company      Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  location     Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  customer     Contact  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  sales        Sale[]   @relation("ConsolidatedInvoiceSales")

  @@index([companyId])
  @@index([customerId])
}
