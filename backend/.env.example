# Server Environment Configuration
NODE_ENV=development
PORT=4401

# Database Connection
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/taysr_erp_v1?schema=public"

# Security (JWT secret MUST be at least 32 characters long in production)
JWT_SECRET=taysr-erp-v1-secret-key-32-characters-minimum-production

# CORS Allowed Origins (Comma-separated list for production, leave empty in development to allow all)
CORS_ORIGINS=http://localhost:5401,https://app.taysr.ma

# Platform Provisioning Secret
TAYSRPOS_PROVISIONING_SECRET=your-secure-provisioning-secret-here

