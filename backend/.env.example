# Server Environment Configuration
NODE_ENV=development
PORT=4400

# Database Connection
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/taysrpos_v0?schema=public"

# Security (JWT secret MUST be at least 32 characters long in production)
JWT_SECRET=taysr-pos-secret-key-32-characters-minimum-production

# CORS Allowed Origins (Comma-separated list for production, leave empty in development to allow all)
CORS_ORIGINS=http://localhost:5400,https://app.taysr.ma

# Platform Provisioning Secret
TAYSRPOS_PROVISIONING_SECRET=your-secure-provisioning-secret-here
