{
  "name": "@taysr/erp-v1-frontend",
  "private": true,
  "version": "1.0.0",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5401 --configLoader native",
    "build": "tsc -b && vite build --config vite.config.ts --configLoader native",
    "typecheck": "tsc -b --pretty false",
    "browser:setup": "bash scripts/setup-headless-browser.sh",
    "screenshot": "node scripts/screenshot.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.0.2",
    "lucide-react": "^1.21.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "recharts": "^3.9.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "puppeteer": "^25.2.1",
    "typescript": "^6.0.3",
    "vite": "^8.2.1"
  }
}
